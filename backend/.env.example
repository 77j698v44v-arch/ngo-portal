PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/ngo_portal
# Set to true for hosted Postgres such as Supabase
DATABASE_SSL=false
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated frontend origins if the frontend is hosted separately (e.g. https://your-site.netlify.app). Blank = allow all.
CORS_ORIGIN=

# Used only by `npm run seed` to create the first chief account
ADMIN_USERNAME=admin
ADMIN_NAME=Project Admin
ADMIN_PASSWORD=
# project_admin or project_coordinator
ADMIN_ROLE=project_admin
